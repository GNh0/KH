      "column_edit_name_emitted_in_csharp": false
    }
  },
  "caller_parameter_rules": [
    "every procedure parameter has a caller source or documented external caller",
    "caller and procedure parameter order stay synchronized",
    "internal and derived values are local procedure variables",
    "raw search and date values cross the caller boundary through established target wrappers including evidenced YYYYMMDD APIs",
    "procedure owns default date and wildcard derivation when target evidence says so",
    "existing target clear query and save helpers precede generic assignments such as DataSource null",
    "simple caller values do not require invented DTO or helper abstractions",
    "result fields match C# bindings and grid FieldName values"
  ],
  "stored_procedure_rules": {
    "required_metadata_fields": [
      "DESCRIPTION"
    ],
    "optional_source_backed_metadata_fields": [
      "AUTHOR",
      "CREATE DATE"
    ],
    "metadata_placeholders_allowed": false,
    "operation_modes": [
      "new_generation",
      "pb_srd_generation",
      "existing_sp_cleanup",
      "approved_inferred_draft"
    ],
