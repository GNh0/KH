        "technical_key",
        "pb_fixed",
        "db_default",
        "server_derived",
        "unused"
      ],
      "ownership_is_mutually_exclusive": true,
      "field_contracts_require_nonempty_field_scoped_evidence": true,
      "field_evidence_sha256_is_recomputed_from_readable_path_or_inline_source": true,
      "xml_contains": ["editable_payload", "technical_key"],
      "csharp_payload_contract_required": true,
      "csharp_payload_table_must_be_directly_serialized": true,
