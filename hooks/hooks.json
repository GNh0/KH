{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ],
        "matcher": "Bash|exec_command|apply_patch|Edit|Write|MultiEdit|Read|read_file"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ],
        "matcher": "Bash|exec_command|apply_patch|Edit|Write|MultiEdit|Read|read_file"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/kh_hook.py",
              "--host",
              "claude"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
