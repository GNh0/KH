{
  "schema_version": 2,
  "contract_id": "pb-csharp-offline-generalized",
  "contract_version": "1.0",
  "normal_generation": {
    "profile_source": "packaged-only",
    "external_discovery_allowed": false,
    "source_text_policy": "passthrough",
    "profile_update_workflow": "profile-update-workflow.md",
    "profile_update_runs_during_normal_generation": false,
    "style_authority": "this packaged contract only",
    "behavior_evidence_only": ["explicitly supplied PB artifacts", "explicitly supplied target artifacts", "user behavior description", "screenshots"],
    "forbidden_style_discovery": ["unapproved external style discovery", "private identity lookup", "source-control metadata lookup", "arbitrary root walk", "sibling-project scan"]
  },
  "profile_maintenance": {
    "separate_from_normal_generation": true,
    "explicit_user_authorization_required": true,
    "root_discovery_forbidden": true,
    "exact_artifact_allowlist": ["one absolute code-behind .cs path", "one absolute .Designer.cs path"],
    "pre_read_requirements": ["profile_id", "profile_version", "unique absolute artifact allowlist", "expected SHA-256 for every allowlisted artifact", "independent provenance for every artifact", "independent custody for every artifact", "exact-set uniqueness decision"],
    "content_read_after_preflight_only": true,
    "post_read_requirements": ["actual SHA-256 equals expected SHA-256", "UTF-8 or UTF-8 BOM decoding", "exactly one AUTHOR header per artifact", "exactly one unique ARTIFACT-ID header per artifact"],
    "output": "unsanitized candidate only",
    "runtime_generation_eligible": false
  },
  "source_authority": {
    "behavior_sources": ["PB", "SRU", "SRD", "DataWindow", "supplied target project"],
    "governs": ["behavior", "captions", "control roles", "bindings", "events", "database mapping"],
    "packaged_contract_role": "sole style authority",
    "behavior_sources_may_override_style": false,
    "target_source_may_select_noncanonical_names": false,
    "missing_evidence": "record a gap; do not invent UX business fields controls or helpers"
  },
  "pbl_parity_evidence": {
    "required_only_for_pbl_source_parity_claim": true,
    "pbl_receipt": ["absolute pbl_path", "pbl_sha256", "pb_runtime", "pb_runtime_version"],
    "object_list_receipt": ["absolute receipt path", "receipt sha256", "same pbl_path and pbl_sha256", "same runtime and runtime_version"],
    "exported_artifacts": ["unique absolute .sru or .srw path with sha256", "unique absolute .srd path with sha256"],
    "linked_datawindow_graph": ["status complete", "node path and sha256 match every exported artifact", "edges bind exported source objects to every exported .srd"],
    "without_complete_receipts": ["proposal-only", "bounded-source-draft"],
    "parity_claim_allowed_without_receipts": false
  },
  "rules": {
    "csharp": {
      "required_patterns": [
        {
          "id": "mapped_form_declaration",
          "pattern": "\\bpartial\\s+class\\s+[A-Za-z_][A-Za-z0-9_]*Form\\s*:\\s*(?:Form|[A-Za-z_][A-Za-z0-9_.<>]*(?:Form|Base))\\b"
        },
        {
          "id": "designer_initialization",
          "pattern": "\\bInitializeComponent\\s*\\("
        },
        {
          "id": "migration_call_path",
          "pattern": "\\b(?:CallSelectProcedure|CallSaveProcedure)\\s*\\("
        },
        {
          "id": "ui_binding_or_result_mapping",
          "pattern": "\\b(?:DataSource|BindingField|FieldName)\\s*="
        }
      ],
      "forbidden_patterns": [
        {
          "id": "alien_convention",
          "pattern": "\\bAlienConvention\\b"
        },
        {
          "id": "invented_request_context_dto",
          "pattern": "\\bclass\\s+[A-Za-z_][A-Za-z0-9_]*(?:Context|Request|Criteria)\\b"
        },
        {
          "id": "runtime_grid_column_factory",
          "pattern": "\\bAddGridColumn\\s*\\(|\\.Columns\\.AddField\\s*\\("
        },
        {
          "id": "inline_wildcard_shaping",
          "pattern": "(?:\\+\\s*\"%\"|\\?\\?\\s*\"%\")"
        }
      ],
      "evidence_requirements": [
        "all required structural pattern identifiers are reported",
        "the mapped form declaration and designer initialization are present",
        "one packaged migration call path is present",
        "one UI binding or result mapping is present",
        "empty source and unrelated class text are rejected"
      ]
    },
    "sql": {
      "allowed_procedure_patterns": [
        "^USP_[A-Z][A-Z0-9_]*_(?:SELECT|SAVE|SELECT_SAVE)$"
      ],
      "forbidden_patterns": [
        {
          "id": "temporary_table",
          "pattern": "#[A-Za-z][A-Za-z0-9_]*"
        },
        {
          "id": "merge",
          "pattern": "\\bMERGE\\b"
        },
        {
          "id": "not_exists",
          "pattern": "\\bNOT\\s+EXISTS\\b"
        }
      ]
    }
  },
  "designer_ownership": {
    "default_owner": ".Designer.cs",
    "designer_file_owns": [
      "control and component field declarations",
      "control and repository construction",
      "static parent containment and collection registration",
      "static Name TabIndex Location Size Dock and Anchor assignments",
      "static BindingField FieldName Caption Text and VisibleIndex assignments",
      "explicit grid columns and Columns.AddRange registration",
      "repository registration and ColumnEdit assignments",
      "static Appearance and Options assignments",
      "other static design-time properties"
    ],
    "code_behind_owns": [
      "runtime behavior and command logic",
      "event handler implementations",
      "procedure calls and validation",
      "runtime result and data binding",
      "evidence-backed dynamic state changes"
    ],
    "code_behind_static_ui_patterns": [
      {
        "id": "control_creation_outside_designer",
        "pattern": "\\bthis\\.[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*new\\s+[A-Za-z_][A-Za-z0-9_.<>]*\\s*\\("
      },
      {
        "id": "static_property_outside_designer",
        "pattern": "\\bthis\\.[A-Za-z_][A-Za-z0-9_]*\\.(?:Name|TabIndex|Location|Size|Dock|Anchor|BindingField|FieldName|VisibleIndex|Caption|Text)\\s*="
      },
      {
        "id": "grid_or_repository_registration_outside_designer",
        "pattern": "\\bthis\\.[A-Za-z_][A-Za-z0-9_]*\\.(?:Columns|RepositoryItems)\\.AddRange\\s*\\("
      },
      {
        "id": "column_repository_assignment_outside_designer",
        "pattern": "\\bthis\\.[A-Za-z_][A-Za-z0-9_]*\\.ColumnEdit\\s*="
      },
      {
        "id": "appearance_or_options_outside_designer",
        "pattern": "\\bthis\\.[A-Za-z_][A-Za-z0-9_]*\\.(?:Appearance|Options)[A-Za-z0-9_.]*\\s*="
      }
    ],
    "dynamic_state_exception": {
      "default": "blocked",
      "requires": [
        "supplied source or explicit behavior evidence",
        "documented runtime reason",
        "targeted verification for the state transition"
      ]
    },
    "evidence_requirements": [
      "generated static UI assignments are inventoried by target file",
      "Designer-owned assignments appear only in the generated Designer file by default",
      "code-behind contains runtime behavior events data binding and approved dynamic state only",
      "every dynamic-state exception records evidence reason and verification",
      "misplaced static UI configuration blocks completion"
    ]
  },
  "style_families": {
    "screens": [
      "browse",
      "master-detail",
      "detail-entry",
      "popup"
    ],
    "methods": [
      "command",
      "event"
    ],
    "procedures": [
      "select",
      "save",
      "select-save"
    ]
  },
  "naming_grammar": {
    "form": "<Feature><Mode>Form",
    "load_handler": "<FormClass>_Load",
    "query_method": "CallSelectProcedure",
    "save_method": "CallSaveProcedure",
    "focus_handler": "gvw<Role>_FocusedRowChanged",
    "controls": {
      "text": "txt<Field>",
      "button_lookup": "btn<Field>",
      "combo_lookup": "cbo<Field>",
      "numeric": "Spin<Field>",
      "date": "ymd<Field>",
      "boolean": "Chk<Field>",
      "memo": "memo<Field>",
      "label": "lbl<Field>",
      "panel": "pn<Role>",
      "group": "grp<Role>",
      "grid": "grd<Role>",
      "view": "gvw<Role>"
    },
    "grid_column": "col<Role>_<FIELD>",
    "repositories": {
      "numeric": "rpsSpin<Field>",
      "other_roles": "use the exact expected_control_contract instance name"
    },
    "procedure": "[dbo].[usp_<Feature>_<Operation>]",
    "procedure_parameter": "@<CALLER_VALUE>",
    "procedure_local": "@Local<DerivedValue>"
  },
  "event_method_shapes": {
    "command_handlers": [
      "SearchCommand",
      "SaveCommand",
      "ClearCommand",
      "DeleteCommand"
    ],
    "select": [
      "keep caller parameters adjacent to the call",
      "keep list and detail branches explicit",
      "return when a required focused row is absent",
      "bind each result table to one documented UI role"
    ],
    "save": [
      "validate before serialization",
      "serialize only documented row states",
      "call one save path",
      "refresh only after success"
    ]
  },
  "control_fallback_order": [
    "target-wrapper",
    "konelib",
    "devexpress",
    "winforms"
  ],
  "wrapper_preservation": {
    "target_project_inspection": "inspect only the supplied target project for available wrappers and APIs",
    "precedence": ["target-project wrapper", "KoneLib wrapper", "declared framework control"],
    "preserve_defaults": true,
    "preserve_existing_properties": ["Size", "Location", "Margin", "MaximumSize", "Visible"],
    "override_authority": "explicit source or user evidence"
  },
  "designer_properties": [
    "Name",
    "BindingField",
    "TabIndex",
    "Location",
    "Size",
    "Dock",
    "Anchor",
    "Text",
    "Caption",
    "EditValue",
    "Properties.*",
    "MainView",
    "ViewCollection",
    "GridControl",
    "Controls.Add",
    "Columns.AddRange"
  ],
  "expected_control_contract": {
    "required": ["instance_name", "expected_type"],
    "optional": ["BindingField", "bindings", "properties", "property_evidence", "evidence_refs"],
    "type_matching": "fully-qualified or short type name",
    "complete_inventory_required": true,
    "complete_inventory": "every selected-form Designer member constructed in InitializeComponent, including custom target wrappers and components, must have exactly one contract entry",
    "initialize_component_scope_required": true,
    "initialize_component_scope": "exactly one ordinary class-member InitializeComponent on the selected partial form; local functions and lookalike methods do not count",
    "evidence_registry_required": true,
    "properties": "exact Designer assignment values",
    "bindings": "exact BindingField FieldName or DataPropertyName assignments; every observed binding must be declared",
    "property_evidence": "property-path keyed evidence_id references resolved through evidence_registry; the property must be declared in the same contract entry",
    "evidence_refs": "entry-level evidence_id references resolved through evidence_registry when property-specific evidence is unavailable; every supplied reference resolves even when no protected override consumes it",
    "exceptions": "a protected default-guard override requires both an exact properties entry and non-empty property_evidence or evidence_refs provenance",
    "role_binding": "lookup search and detail roles require the evidence-backed wrapper or repository and exact BindingField; text controls are not substitutes"
  },
  "no_control_contract_evidence": {
    "use_only_with": "an explicit empty expected_control_contracts list",
    "required": ["reason", "evidence_refs"],
    "evidence_refs": "non-empty evidence_id references resolved through evidence_registry and proving there are intentionally no mapped controls",
    "designer_inventory_must_be_empty": true,
    "omitted_expected_control_contracts": "blocked"
  },
  "control_evidence_registry": {
    "entry_required": ["evidence_id", "kind"],
    "kind": ["source", "user"],
    "stable_binding": "each entry requires locator using artifact file review user or memory URI syntax, or a SHA-256 digest",
    "reference_semantics": "all evidence_refs and property_evidence values are unique evidence_id strings resolved through this registry, never free-form labels",
    "malformed_entries": "blocked, including non-mapping list entries"
  },
  "target_artifact_binding": {
    "required": ["target code-behind path and SHA-256 arguments", "target Designer path and SHA-256 arguments when a separate Designer text is supplied"],
    "verification": "read the exact path, match SHA-256, decode UTF-8, and require byte-decoded text equality with the verified input",
    "role_paths": "code-behind and Designer paths must be distinct",
    "baseline": "existing Designer preservation uses separately captured pre-edit baseline path and SHA-256 arguments; the current target Designer path cannot authorize itself as its baseline"
  },
  "konelib_defaults": {
    "input_auto_height_property": "Properties.AutoHeight",
    "input_auto_height_forbidden_value": true,
    "label_alignment": {
