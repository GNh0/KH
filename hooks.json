{
  "kh-saved-source": {
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {"type": "command", "command": "python -B scripts/kh_antigravity.py PreToolUse", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(view_file|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {"type": "command", "command": "python -B scripts/kh_antigravity.py PostToolUse", "timeout": 10}
        ]
      }
    ],
    "PreInvocation": [
      {"type": "command", "command": "python -B scripts/kh_antigravity.py PreInvocation", "timeout": 10}
    ],
    "Stop": [
      {"type": "command", "command": "python -B scripts/kh_antigravity.py Stop", "timeout": 10}
    ]
  }
}
