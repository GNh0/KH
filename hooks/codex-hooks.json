{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ],
        "matcher": "Bash|exec_command|apply_patch|Edit|Write|MultiEdit|Read|read_file"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ],
        "matcher": "Bash|exec_command|apply_patch|Edit|Write|MultiEdit|Read|read_file"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/kh_hook.py\" --host codex",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/scripts/kh_hook.py\" --host codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
