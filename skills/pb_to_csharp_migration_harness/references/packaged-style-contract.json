      "ordered_parameter_names",
      "complete_balanced_semicolon_terminated_call",
      "globally_balanced_active_code_delimiters",
      "complete_containing_class_struct_or_record",
      "complete_ordinary_containing_method_body",
      "all_active_dbClient_calls_counted_by_csharp_tokens",
      "whitespace_and_comments_between_receiver_dot_method_and_parenthesis_supported",
      "unsupported_dbClient_methods_count_toward_cardinality",
      "exactly_one_total_active_dbClient_call",
      "sole_dbClient_call_is_supported_sp_method",
      "direct_method_body_expression_or_return_context",
      "ordinary_method_requires_plausible_return_type_and_complete_type_scope",
      "builtin_qualified_generic_nullable_array_tuple_and_task_like_return_types_supported",
      "reserved_control_keywords_and_ambiguous_return_types_rejected",
      "interpolated_string_expression_invocations_counted_conservatively",
      "conditional_parenthesized_and_null_forgiving_receivers_counted",
      "constructor_static_constructor_destructor_operator_conversion_accessor_rejected",
      "bare_fragment_top_level_local_function_and_accessor_rejected",
      "lambda_delegate_local_function_and_initializer_context_rejected",
      "exact_case_sensitive_dbClient_receiver_and_method",
      "direct_sp_string_first_top_level_argument",
      "direct_DbParameter_remaining_top_level_arguments",
      "restricted_scalar_DbParameter_value_expression",
      "literal_identifier_member_indexer_method_cast_grouping_unary_and_coalesce_values",
      "lambda_delegate_new_array_initializer_collection_assignment_binary_and_ternary_values_rejected",
      "literal_preprocessor_evaluation",
      "unknown_symbol_caller_evidence_rejected_without_symbol_contract"
    ],
    "branch_contract_requires": [
      "verified",
      "strict_target_procedure",
      "artifact_target_procedure_match",
      "artifact_uri_or_path",
      "sha256",
      "complete_branch_sql",
      "hierarchical_condition_and_arm_paths",
      "nested_branch_occurrences",
      "unified_statement_and_branch_opening_event_order",
      "preceding_sibling_events_for_later_branch_position",
